# Porta local consumida pelo gateway do lifesystems-infra.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8082

# Variavel publica incorporada ao bundle durante o build.
NEXT_PUBLIC_API_BASE_URL=/backend

# URL absoluta usada por chamadas executadas no servidor Next.js.
API_BASE_URL=https://tecnoaging.com.br/backend

# NextAuth em tempo de execucao.
NEXTAUTH_SECRET=gere-uma-chave-forte
NEXTAUTH_URL=https://tecnoaging.com.br
DEV_SKIP_AUTH=false
